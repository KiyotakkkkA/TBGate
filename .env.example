###############################################################################
# Telegram Gateway - environment configuration
#
# Copy to .env and fill in the required values:
#     cp .env.example .env
#
# Generate the two secrets with:
#     openssl rand -hex 32      # APP_ENCRYPTION_KEY  (64 hex chars = 32 bytes)
#     openssl rand -base64 48   # SESSION_SECRET      (any string >= 32 chars)
#
# Never commit a filled-in .env. Every value marked REQUIRED must be set or the
# application refuses to start (fail fast, with a message that never echoes the value).
###############################################################################

# ─────────────────────────────────────────────────────────── Application ────

# Runtime mode. development | test | production
# Optional. Default: production
NODE_ENV=production

# Display name used in the UI, page titles and log records.
# Optional. Default: Telegram Gateway
APP_NAME=Telegram Gateway

# Interface the HTTP server binds to. Keep 0.0.0.0 inside Docker.
# Optional. Default: 0.0.0.0
HOST=0.0.0.0

# Port the HTTP server listens on (plain HTTP; terminate TLS in a reverse proxy).
# Optional. Default: 8080
PORT=8080

# REQUIRED. Absolute, publicly reachable base URL of this gateway.
# Telegram webhook URLs are derived from it: <PUBLIC_BASE_URL>/telegram/webhook/<botId>
# Must be https:// for a real Telegram deployment. No trailing slash.
PUBLIC_BASE_URL=https://telegram.example.com

# Log verbosity: fatal | error | warn | info | debug | trace | silent
# Optional. Default: info
LOG_LEVEL=info

# Human-readable coloured logs for local development. Requires the `pino-pretty` dev
# dependency, which is NOT present in the production image - there the setting is ignored
# with a warning and logs stay JSON. Leave false in production.
# Optional. Default: false
LOG_PRETTY=false

# Trust X-Forwarded-* headers. Enable ONLY when the gateway sits behind a reverse
# proxy you control - otherwise a client can spoof its own IP address.
# Optional. Default: false
TRUST_PROXY=true

# ────────────────────────────────────────────────────────────── Database ────

# SQLite database location, in libsql `file:` URL form.
# Must live on the mounted volume so data survives container replacement.
# Optional. Default: file:/app/data/gateway.sqlite
# Local development (run from the repo root): file:./data/gateway.sqlite
DATABASE_URL=file:/app/data/gateway.sqlite

# ─────────────────────────────────────────────────────── Admin bootstrap ────

# Username of the administrator created on the very first startup.
# Optional. Default: admin
ADMIN_USERNAME=admin

# REQUIRED. Password for that first administrator. Minimum 8 characters.
#
# Used for bootstrap ONLY. Once the account exists, changing this value does NOT
# overwrite the stored password - see docs/SECURITY.md for the reset procedure.
# Change the password from the UI after the first sign-in, then this value is dead weight.
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOYING

# ────────────────────────────────────────────────── Application secrets ─────

# REQUIRED. Master key for AES-256-GCM encryption of Telegram bot tokens and
# destination signing secrets.
#   Format: 64 hex characters, or base64 that decodes to exactly 32 bytes (256 bits).
#   Generate: openssl rand -hex 32
#
# WARNING: this key is never stored in the database. If you lose it, every stored
# bot token and signing secret becomes unrecoverable and must be re-entered.
# Rotating it requires re-entering those secrets - see docs/SECURITY.md.
APP_ENCRYPTION_KEY=

# REQUIRED. Secret used to derive session cookie digests. Minimum 32 characters.
#   Generate: openssl rand -base64 48
# Changing it invalidates all active admin sessions (everyone is signed out).
SESSION_SECRET=

# ────────────────────────────────────────────────────────────── Sessions ────

# Admin session lifetime in hours.
# Optional. Default: 24
SESSION_TTL_HOURS=24

# Set the Secure flag on cookies. Keep true in production (HTTPS).
# Set to false only for plain-HTTP local development, or sign-in will not work.
# Optional. Default: true
COOKIE_SECURE=true

# SameSite policy for the session cookie: lax | strict | none
# Optional. Default: lax
COOKIE_SAME_SITE=lax

# ────────────────────────────────────────────────────────────── Telegram ────

# Telegram Bot API root. Override to point at a local Bot API server.
# Optional. Default: https://api.telegram.org
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Path prefix for inbound webhooks. The bot id is appended: <path>/<botId>.
# The bot token never appears in this URL.
# Optional. Default: /telegram/webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Discard updates Telegram queued while no webhook was registered.
# Optional. Default: false
TELEGRAM_WEBHOOK_DROP_PENDING_UPDATES=false

# Timeout for outbound Telegram Bot API calls, in milliseconds.
# Optional. Default: 15000
TELEGRAM_API_TIMEOUT_MS=15000

# NOTE: bot tokens are NOT configured here. Bots are added through the admin panel
# and their tokens are stored encrypted in the database.

# ─────────────────────────────────────────────────────── Delivery worker ────

# Run the background delivery worker in this process.
# Optional. Default: true
DELIVERY_WORKER_ENABLED=true

# Maximum deliveries attempted concurrently.
# Optional. Default: 5
DELIVERY_WORKER_CONCURRENCY=5

# How often the worker polls the queue for due deliveries, in milliseconds.
# Optional. Default: 1000
DELIVERY_WORKER_POLL_INTERVAL_MS=1000

# Per-request timeout for a webhook delivery, in milliseconds.
# A destination may override this individually.
# Optional. Default: 10000
DELIVERY_TIMEOUT_MS=10000

# Total attempts per delivery, including the first one.
# Optional. Default: 6
DELIVERY_MAX_ATTEMPTS=6

# Backoff schedule in milliseconds, applied after attempt 1, 2, 3, ...
# The first attempt is immediate. The last value repeats if the list is shorter
# than DELIVERY_MAX_ATTEMPTS - 1.
# Optional. Default: 1000,5000,30000,120000,600000
DELIVERY_RETRY_DELAYS_MS=1000,5000,30000,120000,600000

# Bytes of the destination response body kept for troubleshooting. 0 disables capture.
# Optional. Default: 2048
DELIVERY_MAX_RESPONSE_BODY_BYTES=2048

# ───────────────────────────────────────────────────────────── Retention ────

# Days to keep received Telegram events. 0 disables pruning (unbounded growth).
# Optional. Default: 30
EVENT_RETENTION_DAYS=30

# Days to keep completed delivery records. 0 disables pruning.
# Optional. Default: 30
DELIVERY_RETENTION_DAYS=30

# Hours between retention sweeps.
# Optional. Default: 24
CLEANUP_INTERVAL_HOURS=24

# ────────────────────────────────────────────────────────────── Security ────

# Maximum accepted request body size, in bytes. Telegram updates are small; raise
# this only if a downstream integration needs it.
# Optional. Default: 1048576 (1 MiB)
MAX_REQUEST_BODY_BYTES=1048576

# Rate limiting for the HTTP API. The inbound Telegram webhook is always exempt,
# because Telegram bursts when draining a backlog.
# Optional. Default: true
API_RATE_LIMIT_ENABLED=true

# Requests allowed per window, per API key (or per client IP when unauthenticated).
# Optional. Default: 300
API_RATE_LIMIT_MAX=300

# Rate limit window in milliseconds.
# Optional. Default: 60000
API_RATE_LIMIT_WINDOW_MS=60000

# Sign-in attempts allowed per minute per IP address.
# Optional. Default: 10
LOGIN_RATE_LIMIT_MAX=10

# Allow destinations that resolve to private, loopback or link-local addresses.
# Required (true) for Docker service-name routing such as http://python-worker:8000/events.
# Set to false when every destination is a public HTTPS endpoint - it then blocks
# SSRF-style targets including cloud metadata services. See docs/SECURITY.md.
# Optional. Default: true
DESTINATION_ALLOW_PRIVATE_NETWORKS=true

# ───────────────────────────────────────────────────────────────── Misc ─────

# Override the directory containing the built admin SPA. Leave empty to autodetect.
# Optional. Default: (empty)
STATIC_DIR=

# ────────────────────────────────── Release tooling (not read at runtime) ───
# Used by the Makefile and the publishing scripts only.

DOCKERHUB_USERNAME=
IMAGE_NAME=telegram-gateway
IMAGE_TAG=latest
