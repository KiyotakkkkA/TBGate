{
  "name": "telegram-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Telegram Bot Gateway and webhook router with an admin panel",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "dev:api": "pnpm --filter ./backend dev",
    "dev:web": "pnpm --filter ./frontend dev",
    "build": "pnpm --filter ./frontend build && pnpm --filter ./backend build",
    "start": "pnpm --filter ./backend start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter ./backend test",
    "test:watch": "pnpm --filter ./backend test:watch",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter ./backend db:generate",
    "db:migrate": "pnpm --filter ./backend db:migrate",
    "db:studio": "pnpm --filter ./backend db:studio",
    "secrets": "node scripts/generate-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
